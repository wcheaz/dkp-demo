# OpenAI-compatible LLM
# Default: deepseek-chat via the built-in DeepSeek endpoint.
# Leave OPENAI_BASE_URL unset for DeepSeek, or set it together with
# OPENAI_MODEL to target any OpenAI-compatible provider (OpenAI, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=deepseek-chat

# Agent / Frontend wiring
# AGENT_URL: where the Next.js CopilotKit runtime and frontend tools reach the FastAPI agent
AGENT_URL=http://localhost:8000/
# UI_ORIGIN: allowed CORS origin on the agent (must match where the UI is served)
UI_ORIGIN=http://localhost:3000

# The following are consumed only by scripts/deploy/setup-secrets.sh (Kubernetes secrets),
# not by the running application:
LLM_MAX_TOKENS=2000
LLM_CONTEXT_WINDOW=8192
EMBEDDING_MODEL=text-embedding-3-small

# Logging / Observability (optional)
LOGFIRE_TOKEN=
