{
  "name": "pydantic-ai-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "./scripts/run-agent.sh || scripts/run-agent.bat",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently \"npm run start\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "install:agent": "./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "copy-cad-workers": "node scripts/copy-cad-workers.mjs",
    "postinstall": "npm run install:agent && npm run copy-cad-workers && node scripts/patch-three-dxf-loader.js"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.48",
    "@copilotkit/react-core": "^1.60.2",
    "@copilotkit/react-textarea": "^1.60.2",
    "@copilotkit/react-ui": "^1.60.2",
    "@copilotkit/runtime": "^1.60.2",
    "@mlightcad/cad-simple-viewer": "1.4.13",
    "@mlightcad/data-model": "^1.7.20",
    "@tailwindcss/postcss": "^4",
    "@types/papaparse": "^5.5.2",
    "lodash": "^4.17.21",
    "next": "16.1.0",
    "next-intl": "^4.12.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4",
    "three": "^0.184.0",
    "three-dxf-loader": "^5.2.0",
    "typescript": "^5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1"
  },
  "pnpm": {
    "overrides": {
      "troika-three-text": "^0.52.4",
      "troika-three-utils": "^0.52.4"
    }
  }
}
